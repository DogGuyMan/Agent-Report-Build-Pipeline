node_modules/

# 테스트용 esbuild 중간 산출물 (viz/lib.mjs)
.tmp/
.tmp-report.mjs

# 빌드 산출물 — 소스에서 재생성한다 (인계 문서 §B-3 "git에는 소스만 커밋")
out/
*out/
**/specs/*/out/

# Phase 1 검증용 임시 이식본 (viz/patch-legacy.mjs)
*.b1.html

.DS_Store

# 파이썬 가상환경 - requirements.txt 로 각자 만든다 (npm run doctor 가 확인한다)
.venv/

# Track C 다이어그램 산출물 — codegraph 에서 재생성한다
out/diagrams/
.tmp-report-tsconfig.json

# 파이썬 바이트코드 캐시 - 소스 실행 시 자동 재생성된다
__pycache__/

# 로컬 유지보수 도구 - 기계마다 다른 경로가 규칙에 박혀 있어 공유하지 않는다
tools/scrub_local_paths.py

# ai-readiness-cartography 출력 - report.json 에 로컬 경로가 들어간다
.claude/readiness/

# 분리 작업 대조 도구(split-work/)의 산출물 — 기준 출력 · 후보 diff 에 이 기계의 절대 경로가 실린다
split-work/before*/
split-work/after*/
split-work/fixture-shards/
split-work/patches/
split-work/frag/
split-work/reading-mode*.json
