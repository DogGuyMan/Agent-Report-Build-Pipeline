+def nonnode_layers(level: int, first: Mapping[str, GraphNode], keep: Collection[str], cg: CodeGraph,
+                   file_cap: int | None = None) -> list[PlanLayer]:
+    """맨 끝의 비노드 층 둘. 첫 층은 `file` 줄과 `file` 세션들, 둘째 층은 `module` 줄과 나머지 세션들이다.
