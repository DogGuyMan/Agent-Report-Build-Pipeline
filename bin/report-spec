#!/usr/bin/env node
// <include file="machine/comments.xml" path="//term[@id='report-spec']"/>
// Mode 2 의 진입점. 설계 검토 보고서를 만든다.
// 쓰는 것: runDispatch · 쓰이는 곳: report
// bin/report-spec — Mode 2. Spec/Plan 설계 검토 보고서.
import { dirname } from "node:path";
import { fileURLToPath } from "node:url";
import { runDispatch } from "../runner/dispatch.mjs";

const ROOT = dirname(dirname(fileURLToPath(import.meta.url)));

runDispatch({
  root: ROOT,
  argv: process.argv.slice(2),
  table: {
    init: "viz/init.mjs",
    build: "viz/build.mjs",
    check: "viz/check.mjs",
  },
  usage: "사용법 — report-spec <init|build|check> [인자]",
});
