#!/usr/bin/env node
// <include file="machine/comments.xml" path="//term[@id='report-term']"/>
// Mode 1.5 의 진입점. 용어를 얼마나 아는지 점검한다.
// 쓰는 것: 없음 · 쓰이는 곳: 없음
// bin/report-term — Mode 1.5. 용어 이해도 점검.
//   collect : 이 Plan 을 이해하는 데 필요한 용어를 모은다
//   grade   : 채운 기입란과 문항지를 대조해 채점하고 확실/모름을 매긴다 (인자 둘)
//   (문항 출제는 CLI 의 일이 아니다 — term-benchmark 스킬이 맡는다)
//   emit    : 학습 노트와 용어집 DB 를 낸다
import { dirname } from "node:path";
import { fileURLToPath } from "node:url";
import { runDispatch } from "../runner/dispatch.mjs";

const ROOT = dirname(dirname(fileURLToPath(import.meta.url)));

runDispatch({
  root: ROOT,
  argv: process.argv.slice(2),
  table: {
    collect: "runner/term/collect.mjs",
    grade: "runner/term/quiz.mjs",
    emit: "runner/term/emit.mjs",
  },
  usage: "사용법 — report-term <collect|grade|emit> [인자]",
});
