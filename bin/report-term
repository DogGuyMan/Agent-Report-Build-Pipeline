#!/usr/bin/env python3
# <include file="machine/comments.xml" path="//term[@id='report-term']"/>
# Mode 1.5 의 진입점. 용어를 얼마나 아는지 점검한다.
# 쓰는 것: 없음 · 쓰이는 곳: 없음
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)

from runner.dispatch import run_dispatch

run_dispatch(
    root=ROOT,
    argv=sys.argv[1:],
    table={
        "collect": "runner/term/collect.mjs",
        "grade": "runner/term/quiz.mjs",
        "emit": "runner/term/emit.mjs",
    },
    usage="사용법 — report-term <collect|grade|emit> [인자]"
)
