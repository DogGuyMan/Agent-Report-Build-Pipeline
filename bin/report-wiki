#!/usr/bin/env python3
// <include file="machine/comments.xml" path="//term[@id='report-wiki']"/>
// 코드베이스 위키를 만드는 진입점. 세 명령으로 갈린다.
// 쓰는 것: 없음 · 쓰이는 곳: 없음
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)

from runner.dispatch import run_dispatch

run_dispatch(
    root=ROOT,
    argv=sys.argv[1:],
    table={
        "prep": "runner/wiki/prep.py",
        "build": "runner/wiki/build.py",
        "check": "runner/wiki/check.py",
    },
    usage="사용법 — report-wiki <prep|build|check> <저장소 경로>"
)
