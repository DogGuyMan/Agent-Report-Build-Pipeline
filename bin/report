#!/usr/bin/env python3
# <include file="machine/comments.xml" path="//term[@id='report']"/>
# 옛 이름의 진입점. 하는 일 없이 report-spec 을 그대로 대신 실행한다.
# 쓰는 것: 없음 · 쓰이는 곳: 없음
# bin/report — 옛 진입점. Mode 2(report-spec)로 위임한다.
# mode 별 바이너리 분리 이전의 습관을 끊지 않기 위해 남긴다.
import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

print("알림 — report 는 report-spec 으로 바뀌었다. 같은 동작을 그대로 수행한다.", file=sys.stderr)
r = subprocess.run([sys.executable, os.path.join(ROOT, "bin/report-spec"), *sys.argv[1:]])
sys.exit(r.returncode)
