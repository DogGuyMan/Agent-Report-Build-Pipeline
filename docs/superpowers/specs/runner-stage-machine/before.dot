  subgraph cluster_m2 { label="run_mode2.py"; style=dashed; color="#b9c0cc"; fontsize=10;
    m2loop [label="main() — for stage in stages\n(같은 모양, 다른 사본)" fillcolor="#fdf3e0" color="#d2a03c"];
    m2plan [label="plan_stages()  (사본 3)" fillcolor="#fdf3e0" color="#d2a03c"];
  }

  m1loop -> m1var [style=dotted arrowhead=none];

  m15loop -> m1meas [label="import run_mode1" color="#d9534f" fontcolor="#d9534f"];
  m2loop  -> m1meas [label="import run_mode1" color="#d9534f" fontcolor="#d9534f"];
  m1meas  -> m1boot [label="같은 파일이라 딸려 온다" style=dashed color="#d9534f" fontcolor="#d9534f"];
