digraph before {
  rankdir=TB;
  graph [fontname="Apple SD Gothic Neo", fontsize=11, bgcolor="transparent", nodesep=0.28, ranksep=0.42];
  node  [fontname="Apple SD Gothic Neo", fontsize=10, shape=box, style="filled,rounded",
         fillcolor="#f4f5f7", color="#c3c8d0", penwidth=1.1, margin="0.14,0.07"];
  edge  [fontname="Apple SD Gothic Neo", fontsize=9, color="#8b93a1", arrowsize=0.7];

  subgraph cluster_static {
    label="정적 계층"; color="#c3c8d0"; fontcolor="#5b6472"; style=rounded;
    dump  [label="roslyn-dump.json\ntypes · relations"];
    norm  [label="normalize.py"];
    cg    [label="codegraph.json\n231 노드 · 540 간선"];
    facts [label="facts/*.md · ranking.json\nmodules · classes · hotspot"];
    dump -> norm -> cg -> facts;
  }

  src [label="사용자 소스 .cs\n114 파일 · 8,456 줄", fillcolor="#fdeaea", color="#d9534f", penwidth=1.6];

  subgraph cluster_llm {
    label="LLM 계층"; color="#c3c8d0"; fontcolor="#5b6472"; style=rounded;
    llm  [label="deep-wiki 에이전트", fillcolor="#eef2fb", color="#8fa4d4"];
    wiki [label="위키 10장\n인용 745건"];
    llm -> wiki;
  }

  ver [label="verify_citations.py\nL1·L2·L3", fillcolor="#eaf5ec", color="#6aa06f"];

  facts -> llm [label="정적 재료"];
  src   -> llm [label="전수 정독", color="#d9534f", penwidth=2.4, fontcolor="#c0392b"];
  wiki  -> ver;
  cg    -> ver [style=dashed, constraint=false];
}
